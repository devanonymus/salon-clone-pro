{
  "name": "salon-clone-pro",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --if-present build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter api test:ci",
    "test:e2e": "pnpm --filter api test:e2e:ci",
    "prisma:validate": "pnpm --filter api exec prisma validate --config ../../prisma.config.ts",
    "prisma:generate": "pnpm --filter api exec prisma generate --config ../../prisma.config.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "admin:bootstrap": "pnpm --filter api exec ts-node src/platform/bootstrap.ts",
    "admin:deliver-mail": "pnpm --filter api exec ts-node src/platform/deliver-mail.ts",
    "test:admin-db": "node scripts/admin-db.test.mjs",
    "test:security-db": "node scripts/security-db.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@types/bcryptjs": "^3.0.0",
    "tsx": "^4.21.0"
  },
  "pnpm": {
    "overrides": {
      "next>sharp": "0.35.5",
      "multer@>=2.0.0 <2.5.0": "2.5.0",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "fast-uri@>=3.0.0 <3.1.7": "3.1.9",
      "postcss@>=8.0.0 <8.5.18": "8.5.23",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "hono@>=4.0.0 <4.12.25": "4.12.25",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "qs@>=6.0.0 <6.16.1": "6.16.1",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "handlebars@>=4.0.0 <4.7.10": "4.7.10",
      "zod@>=4.0.0 <4.6.6": "4.6.6",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1",
      "webpack@>=5.0.0 <5.112.0": "5.112.0"
    }
  }
}
