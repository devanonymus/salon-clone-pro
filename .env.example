DATABASE_URL=postgresql://user:password@localhost:5432/salon_pro
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Use long, randomly generated values in every deployed environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=28800
JWT_ISSUER=salon-pro-api
JWT_AUDIENCE=salon-pro-web

# Encrypts tenant WhatsApp access tokens at rest (minimum 32 characters).
WHATSAPP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-token
# Meta App Secret used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=replace-with-the-meta-app-secret
WHATSAPP_HTTP_TIMEOUT_MS=10000

# DEMO never marks a sale as a real fiscal receipt.
FISCAL_PROVIDER=DEMO

# Keep both disabled in production unless explicitly needed.
ALLOW_DEMO_SEED=false
ALLOW_TENANT_PROVISIONING=false
DEMO_TENANT_CODE=SALON1
DEMO_TENANT_NAME=Salon Test
DEMO_USERNAME=admin
DEMO_PIN=
# Platform administration. Configure real values in the environment secret manager.
PLATFORM_ENCRYPTION_KEY=
PLATFORM_WEB_URL=http://localhost:3000
# Frontend build-time backend URL for the same-origin platform proxy.
PLATFORM_API_URL=http://127.0.0.1:8080
# Required for real invitation delivery; no emails are sent without a configured worker.
PLATFORM_MAIL_GATEWAY_URL=
PLATFORM_MAIL_GATEWAY_TOKEN=
